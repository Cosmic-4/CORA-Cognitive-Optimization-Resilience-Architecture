# CORA Environment Configuration

# Bright Data Scraper Studio
BRIGHT_DATA_API_TOKEN=your_bright_data_api_token_here
BRIGHT_DATA_COLLECTOR_ID=c_your_collector_id_here

# CORA Mode — clearly separate Live vs Mock vs Demo
# LIVE (real): set CORA_MOCK_MODE=false → backend hits Bright Data Scraper Studio (if BRIGHT_DATA_COLLECTOR_ID set)
#              else auto-falls back to real public APIs (dummyjson → fakestore) → returns actual structured live data
#              + genuine self-healing: 0-records / contract-invalid / drift → anomaly → repair → shadow → promote
# MOCK: CORA_MOCK_MODE=true → mockData() preloaded (fast local dev)
# DEMO (simulated): POST /api/demo/pipeline → injects rare selector-drift / malformed scenario (clearly tagged source=demo)
CORA_MOCK_MODE=true

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///cora.db

# Frontend Origin (for CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Gemini AI (optional - for AI-assisted repairs)
GEMINI_API_KEY=
